# Required public/browser settings (embedded at build time).
# Use the same project and browser-safe publishable key as the server settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Required server settings for authentication and user-scoped database requests.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only secret: required for account deletion, not normal tracking or MCP.
# Never prefix this variable with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only secret: required for the AI assistant.
# Legacy OPENAI_* names configure Gemini; use a Gemini key from Google AI Studio.
OPENAI_API_KEY=your_gemini_api_key

# Optional server settings. These are the defaults and the only accepted model/endpoint.
OPENAI_MODEL=gemini-3.6-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Optional existing project metadata; not read by the application runtime.
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_PROJECT_ID=your_supabase_project_id
